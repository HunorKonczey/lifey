#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// google_mobile_ads includes GoogleMobileAds_Beta.h from the SDK's PrivateHeaders
// inside its own framework module, which clang rejects when building that module.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
