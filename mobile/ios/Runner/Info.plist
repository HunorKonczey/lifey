<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lifey</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lifey</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>A kamera használata szükséges az élelmiszerek vonalkódjának beolvasásához, illetve profilkép készítéséhez.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>A fényképtár elérése szükséges a profilkép kiválasztásához.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>A Lifey az Apple Health-ből olvassa be az edzéseket, a lépésszámot és a testsúlyt, hogy automatikusan kiegészítse a naplódat.</string>
	<!-- Cardio GPS-nyomvonal (docs/cardio/54-cardio-gps-route-plan.md §3.1–3.2)
	     — csak "while in use" szintet kérünk, sosem "always". -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Az útvonal és a táv méréséhez helyadat kell; enélkül is elindíthatod az edzést, csak nyomvonal nélkül.</string>
	<!-- Zenevezérlés edzés közben, Apple Music ág (docs/music/46-workout-music-controls-plan.md §2.2, M3). -->
	<key>NSAppleMusicUsageDescription</key>
	<string>A Lifey a Zene könyvtáradhoz fér hozzá, hogy edzés közben megjelenítse a szóló számot, és app-váltás nélkül vezérelhesd a lejátszást (lejátszás, szüneteltetés, következő/előző szám).</string>
	<!-- AdMob (docs/landing_page/67-mobile-free-pro-plan.md §5, Prompt 8).
	     Google's public TEST app id — swap for the real AdMob App ID from
	     the AdMob console before this ships ads (Prompt 9/10). -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- ATT prompt for personalized-ads tracking (63 D-M7, 67 §5.1) — shown
	     by the UMP/AdMob SDK itself, not a custom pre-prompt (69 §4.6). -->
	<key>NSUserTrackingUsageDescription</key>
	<string>A Lifey ezt az azonosítót releváns reklámok megjelenítésére használja. Pro előfizetéssel ez teljesen kikapcsolható.</string>
	<!-- TODO (before Prompt 9/10 ships ads): SKAdNetworkItems — Apple's
	     ad-network attribution list, published by Google at
	     https://developers.google.com/admob/ios/quick-start#update_your_infoplist
	     and required for AdMob to attribute installs correctly on iOS 14+.
	     Not needed for Prompt 8 (SDK init + consent only, no ad request). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Zenevezérlés: az Apple Music app megnyitásához a noActiveSession
	     üres állapot CTA-jából (docs/music/46-workout-music-controls-plan.md
	     §2.2/§3.5, M3). Spotify/YouTube Music sémái M4-ben kerülnek ide. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>music</string>
	</array>
	<!-- Live Activities (docs/24-ios-widget-live-activity-plan.md) -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Cardio GPS háttérfutás (docs/cardio/54-cardio-gps-route-plan.md §4.4, C4a.5b)
	     — whileInUse mellett is engedélyezi a folyamatos rögzítést, amíg a
	     tracking már fut a háttérbe kerüléskor; nem kér "Always" szintet. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- Google Sign-In: the reversed form of the iOS OAuth client ID
	     (Google Cloud Console → Credentials → Lifey iOS). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1086901320421-qfnu12ba4k4uhf6pl2aanra5pk1rp2la</string>
			</array>
		</dict>
		<!-- Widget / Live Activity deep link (docs/24-ios-widget-live-activity-plan.md) -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lifey</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
