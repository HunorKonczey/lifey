# =============================================================================
# lifey-api — the three variables the chat split adds
# =============================================================================
# This is NOT the full lifey-api environment. It is only what has to be ADDED
# to the existing service; everything already there stays untouched.
#
# Import: Render > lifey-api > Environment > "Add from .env" > paste this file.
# Render merges by key, so existing variables are left alone.
#
# Runbook: docs/chat/44-chat-service-extraction-plan.md §10.2 (steps 2, 5, 7)
# =============================================================================


# --- Step 2: the shared secret -----------------------------------------------
# Guards /internal/push on THIS service, and is sent on outbound calls to the
# chat. The SAME value goes on lifey-chat. Generate one with:
#   openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_'
#
# Empty CLOSES the internal API rather than opening it — a forgotten value means
# no push notifications (loud, fixable), not an open endpoint.
LIFEY_INTERNAL_TOKEN=<<< FILL IN — same value as on lifey-chat >>>


# --- Step 5: where the chat service is (server to server) --------------------
# Used by the revoke webhook: when a trainer-client relationship ends, this
# service tells the chat to freeze the pair's thread. ORIGIN only — no /api/v1,
# no trailing slash.
#
# Empty disables the webhook. Not fatal (the chat re-checks the relationship on
# every send, and a nightly sweep catches what was missed), but threads would
# look active for up to a day after being revoked.
CHAT_INTERNAL_URL=<<< FILL IN — https://<chat-service>.onrender.com >>>


# --- Step 7: where the chat service is (for the clients) ---------------------
# Handed to mobile and web at runtime by GET /api/v1/client-config. THIS is the
# variable that sends clients to the chat service — set it LAST, after the smoke
# test passes, because until then nothing is talking to the chat.
#
# Include the /api/v1 suffix here (unlike CHAT_INTERNAL_URL above): clients
# append paths like /chat/conversations to it.
#
# EMPTYING IT IS THE ROLLBACK — but know what that means: this API no longer
# serves /api/v1/chat/**, it answers 404. Emptying this makes a broken chat fail
# cleanly; it does not restore one.
CHAT_PUBLIC_BASE_URL=<<< FILL IN — https://<chat-service>.onrender.com/api/v1 >>>


# --- Optional ----------------------------------------------------------------
# How long clients may cache the answer above. Set this to 300 for the deploy
# and the following days, so a rollback propagates in minutes instead of hours;
# put it back to 21600 (6h) once things are quiet.
# CLIENT_CONFIG_TTL_SECONDS=21600
