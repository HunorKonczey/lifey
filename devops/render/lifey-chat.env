# =============================================================================
# lifey-chat — Render environment
# =============================================================================
# Import: Render > lifey-chat > Environment > "Add from .env" > paste this file.
#
# Every line below is either filled in or marked <<< FILL IN >>>. Commented
# lines are optional tuning that already has the right default in
# chat/src/main/resources/application.yml — uncomment only what you want to
# override, so the dashboard stays readable.
#
# Runbook: docs/chat/44-chat-service-extraction-plan.md §10
# Database setup: devops/chat-database-split.md
# =============================================================================


# --- Profile -----------------------------------------------------------------
# Turns off Swagger UI and /v3/api-docs, so the API surface isn't advertised.
SPRING_PROFILES_ACTIVE=prod


# --- Memory ------------------------------------------------------------------
# MEASURED, not guessed. Metaspace peaked at 99 MB with every endpoint
# exercised, so 128m leaves ~29 MB of headroom — a 96m cap booted fine and then
# died on the first request. Still 64 MB below lifey-api's, because the Firebase
# Admin SDK is not in this JVM (push goes over HTTP to the API).
# An SSE connection costs ~107 KB, so 192m of heap is plenty for the
# connections; it is ordinary request work that fills it.
JAVA_OPTS=-Xms64m -Xmx192m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m

# Do NOT set PORT. Render injects it and the app binds to whatever it gets.


# --- Database ----------------------------------------------------------------
# The SAME URL as lifey-api — one database, two roles. Copy it verbatim from
# lifey-api's Environment tab. A typo here means two separate databases and
# nothing will tell you: the chat would just start up empty.
# Format: jdbc:postgresql://<host>.neon.tech/lifey?sslmode=require
SPRING_DATASOURCE_URL=<<< FILL IN — copy from lifey-api, must match exactly >>>

# NOT the monolith's role. lifey_chat owns chat_* and has SELECT-only on
# users / user_settings / trainer_clients — those grants are what stop a bug
# here writing to the API's tables. Create it with devops/chat-database-split.md.
SPRING_DATASOURCE_USERNAME=lifey_chat
SPRING_DATASOURCE_PASSWORD=<<< FILL IN — the lifey_chat role password >>>


# --- Auth --------------------------------------------------------------------
# BIT-IDENTICAL to lifey-api's JWT_SECRET. This is the entire trust relationship
# between the two services: the API issues tokens, this service only verifies
# them. A mismatch is a 401 on every single chat request — which is the first
# thing to check if the smoke test fails at step 1.
JWT_SECRET=<<< FILL IN — copy from lifey-api, must match exactly >>>

# The `iss` claim this service requires. lifey-api mints tokens with this value;
# leave it alone unless you change it there too.
JWT_ISSUER=lifey-api


# --- The seam with lifey-api -------------------------------------------------
# Shared secret for /internal/**, in both directions. The SAME value goes on
# lifey-api. Generate one with:  openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_'
#
# An EMPTY value CLOSES the internal API rather than opening it: a deployment
# that forgot this loses push notifications, which is loud and fixable. The
# other default would be an unauthenticated endpoint able to notify any user.
LIFEY_INTERNAL_TOKEN=<<< FILL IN — same value as on lifey-api >>>

# Where this service sends push requests. The API's ORIGIN, no /api/v1 suffix
# and no trailing slash — /internal/push is not under the versioned API.
LIFEY_API_INTERNAL_URL=https://lifey.onrender.com


# --- CORS --------------------------------------------------------------------
# The web admin's exact origin(s), comma-separated, no trailing slash.
# Mobile is unaffected by CORS, which makes this the easiest mistake to miss:
# the phone will work perfectly while the web chat is completely broken.
# Include the preview domain if you use it, same as lifey-api's own setting.
CORS_ALLOWED_ORIGINS=https://lifey-web.vercel.app


# --- Feature switch ----------------------------------------------------------
# The incident lever, not a rollout flag. false leaves every thread readable and
# refuses new messages with 503; the mobile outbox holds them until you flip it
# back. Realtime, push and the reminder job are unaffected by it.
CHAT_ENABLED=true


# =============================================================================
# OPTIONAL — the defaults below are already in application.yml.
# Uncomment a line only to override it.
# =============================================================================

# --- Limits ------------------------------------------------------------------
# CHAT_MAX_BODY_LENGTH=2000
# CHAT_RATE_LIMIT_PER_MINUTE=30
# CHAT_RATE_LIMIT_PER_DAY=600
# CHAT_DEFAULT_PAGE_SIZE=30
# CHAT_MAX_PAGE_SIZE=100
# CHAT_SEARCH_MIN_LENGTH=2

# --- Realtime (SSE) ----------------------------------------------------------
# How long one connection lives before the server closes it and the client
# reconnects. Also the leak bound: a leaked emitter cannot outlive this.
# CHAT_STREAM_TIMEOUT=5m
# Comment frames that stop a proxy closing an idle stream. Must stay comfortably
# under any reverse-proxy read timeout in front of the app.
# CHAT_STREAM_HEARTBEAT=20s
# CHAT_STREAM_CATCH_UP_LIMIT=200
# CHAT_PRESENCE_TTL=2m
# CHAT_TYPING_THROTTLE=2s
# CHAT_TYPING_TTL=5s

# --- Notifications -----------------------------------------------------------
# At most one push per thread per window, so a burst is one interruption.
# CHAT_PUSH_COALESCE_WINDOW=60s
# CHAT_REMINDER_AFTER=30m
# Most reminders one user can get per day. <= 0 disables the reminder job.
# CHAT_REMINDER_DAILY_CAP=1
# The §5.5 email fallback is NOT implemented in this service (see plan §6.3) —
# turning it on only produces a warning in the log. Left here so nobody wonders
# where it went.
# CHAT_EMAIL_FALLBACK_ENABLED=false
# CHAT_EMAIL_FALLBACK_AFTER=24h

# --- Attachments -------------------------------------------------------------
# Largest accepted upload, measured before re-encoding. Below the container-wide
# multipart cap of 10 MB.
# CHAT_ATTACHMENT_MAX_BYTES=8388608
# CHAT_ATTACHMENT_MAX_SIDE=1600
# CHAT_ATTACHMENT_THUMBNAIL_SIZE=400

# --- Scheduled jobs ----------------------------------------------------------
# THIS SERVICE MUST RUN AS A SINGLE INSTANCE, and these are why: two instances
# would each fire them, and duplicate reminders are the one scaling hazard users
# actually see. See plan §6.4 before changing the instance count.
# JOB_CHAT_UNREAD_REMINDER_CRON=0 */5 * * * *
# Nightly sweep that catches a lost revoke webhook. The counter it feeds
# (lifey.chat.relationship.reconciled) should stay at zero.
# JOB_CHAT_RELATIONSHIP_RECONCILIATION_CRON=0 15 4 * * *

# --- Outbound HTTP -----------------------------------------------------------
# Short on purpose: the push call runs after the message is already committed
# and already served over REST, so a slow API must never hold a chat request
# thread. A dropped push is picked up by the reminder job.
# LIFEY_API_CONNECT_TIMEOUT=2s
# LIFEY_API_READ_TIMEOUT=5s
